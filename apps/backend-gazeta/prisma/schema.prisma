generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  news      News[]

  @@map("users")
}

model Category {
  id             Int            @id @default(autoincrement())
  name           String         @unique
  description    String?        @db.Text
  slug           String         @unique
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  newsCategories NewsCategory[]

  @@map("categories")
}

model News {
  id             Int            @id @default(autoincrement())
  title          String         @db.VarChar(255)
  subtitle       String         @db.Text
  content        String         @db.LongText
  author         String         @db.VarChar(200)
  published      String         @db.VarChar(50) @default("false")
  views          Int            @default(0)
  status         String         @db.VarChar(50)
  validity       String         @db.VarChar(50)
  slug           String         @unique @db.VarChar(255)
  isEmphasis     Boolean        @default(false) @map("is_emphasis")
  createdAt      DateTime       @default(now()) @map("created_at")
  updateAt       DateTime       @updatedAt @map("update_at")
  authorId       Int            @map("author_id")
  authorUser     User           @relation(fields: [authorId], references: [id])
  newsCategories NewsCategory[]
  mediaNews      NewsMedia[]
  videoNews      NewsVideo[]

  @@index([authorId], map: "news_author_id_fkey")
  @@map("news")
}

model NewsMedia {
  id       Int     @id @default(autoincrement())
  emphasis Boolean @default(false)
  imgSize  Json?   @map("img_size")
  author   String? @db.VarChar(200)
  date     String? @db.VarChar(50)
  newsId   Int     @map("news_id")
  news     News    @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@index([newsId], map: "news_media_news_id_fkey")
  @@map("news_media")
}

model NewsVideo {
  id        Int    @id @default(autoincrement())
  url       String @db.VarChar(500)
  thumbnail String @db.VarChar(500)
  newsId    Int    @map("news_id")
  news      News   @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@index([newsId], map: "news_video_news_id_fkey")
  @@map("news_video")
}

model NewsCategory {
  newsId     Int      @map("news_id")
  categoryId Int      @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  news       News     @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@id([newsId, categoryId])
  @@index([categoryId], map: "news_categories_category_id_fkey")
  @@map("news_categories")
}
